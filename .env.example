# ─── Database ───
# DATABASE_URL takes precedence; individual DB_* vars are fallback
DATABASE_URL=postgresql://postgres:password@localhost:5432/kiosque?client_encoding=utf8
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=changeme
# DB_NAME=kiosque

# ─── JWT ───
JWT_SECRET=generate-a-random-64-char-hex-secret-here

# ─── Server ───
NODE_ENV=development
BACKEND_PORT=3001
HOST=0.0.0.0

# ─── CORS ───
# Comma-separated origins or * for all
CORS_ORIGIN=*

# ─── Domains ───
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
WS_URL=ws://localhost:3001

# ─── Frontend Ports ───
KIOSKE_PORT=3000
STAFF_PORT=3002
MONITOR_PORT=3003
STUDENT_PORT=3004

# ─── Frontend (Next.js public vars) ───
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_STAFF_PORT=3002
NEXT_PUBLIC_KIOSKE_PORT=3000
NEXT_PUBLIC_MONITOR_PORT=3003
NEXT_PUBLIC_STUDENT_PORT=3004

# ─── SMTP (Email notifications) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS="your-app-password"
SMTP_FROM="Kioske Digital <your-email@gmail.com>"
